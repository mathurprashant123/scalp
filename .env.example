# Copy this file to ".env" (same folder) and fill in your REAL testnet
# API key/secret. The ".env" file itself is gitignored -- it will NEVER
# be pushed to GitHub, only this .example template (with no real values)
# gets committed.

DELTA_API_KEY=paste_your_testnet_api_key_here
DELTA_API_SECRET=paste_your_testnet_api_secret_here
